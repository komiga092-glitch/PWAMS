{
  "name": "pwams",
  "version": "1.0.0",
  "description": "People Welfare Association Management System",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.offline.json",
    "watch": "tsc --watch",
    "templ:generate": "templ generate",
    "templ:watch": "templ generate --watch --proxy http://localhost:8080",
    "go:build": "go build -o bin/pwams.exe ./cmd/server",
    "go:run": "go run ./cmd/server",
    "go:test": "go test ./... -v",
    "go:lint": "golangci-lint run ./...",
    "dev": "npm run build && concurrently \"npm run templ:watch\" \"npm run watch\" \"go run ./cmd/server\"",
    "test": "go test ./... -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komiga092-glitch/pwams.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/komiga092-glitch/pwams/issues"
  },
  "homepage": "https://github.com/komiga092-glitch/pwams#readme",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
