package components

templ Sidebar() {
	<aside class="sidebar" data-sidebar>
		<a class="brand" href="/dashboard">
			<div class="brand-mark">PWA</div>
			<div>
				<div class="brand-title">PWAMS</div>
				<div class="brand-subtitle">People Welfare Association</div>
			</div>
		</a>
		<nav class="nav">
			<div class="nav-section">Main</div>
			<a class="nav-link" href="/dashboard" data-roles="Super Admin,Admin,Staff,Volunteer,Donor,Beneficiary">
				<span class="nav-icon">⌂</span><span>Dashboard</span>
			</a>
			<a class="nav-link" href="/persons/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">♙</span><span>Care Seekers</span>
			</a>
			<a class="nav-link" href="/care-provided/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">🤝</span><span>Care Provided</span>
			</a>
			<div class="nav-section">Management</div>
			<a class="nav-link" href="/students/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">🎓</span><span>Students</span>
			</a>
			<a class="nav-link" href="/donors/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">♡</span><span>Donors</span>
			</a>
			<a class="nav-link" href="/donations/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">◈</span><span>Donations</span>
			</a>
			<a class="nav-link" href="/aid-requests/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">▣</span><span>Aid Requests</span>
			</a>
			<a class="nav-link" href="/loans/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">₹</span><span>Loans</span>
			</a>
			<a class="nav-link" href="/loan-repayments/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">↻</span><span>Repayments</span>
			</a>
			<a class="nav-link" href="/revenue/page" data-roles="Super Admin,Admin">
				<span class="nav-icon">¤</span><span>Revenue</span>
			</a>
			<div class="nav-section">Account</div>
			<a class="nav-link" href="/profile">
				<span class="nav-icon">◉</span><span>My Profile</span>
			</a>
			<a class="nav-link" href="/notifications/page">
				<span class="nav-icon">♢</span><span>Notifications</span>
				<span id="notifications-unread-count" class="nav-count" hidden>0</span>
			</a>
			<a class="nav-link" href="/messages/page">
				<span class="nav-icon">✉</span><span>Messages</span>
				<span id="messages-unread-count" class="nav-count" hidden>0</span>
			</a>
			<a class="nav-link" href="/files/page" data-roles="Super Admin,Admin,Staff">
				<span class="nav-icon">▤</span><span>Files</span>
			</a>
			<a class="nav-link" href="/users/page" data-roles="Super Admin,Admin">
				<span class="nav-icon">♟</span><span>Users</span>
			</a>
			<a class="nav-link" href="/reports/dashboard/page" data-roles="Super Admin,Admin">
				<span class="nav-icon">▥</span><span>Reports</span>
			</a>
			<a class="nav-link" href="/audit-logs/page" data-roles="Super Admin,Admin">
				<span class="nav-icon">◫</span><span>Audit Logs</span>
			</a>
			<form class="logout-form" method="post" action="/logout">
				<button class="nav-link logout-button" type="submit">
					<span class="nav-icon">↪</span><span>Logout</span>
				</button>
			</form>
		</nav>
	</aside>
}
