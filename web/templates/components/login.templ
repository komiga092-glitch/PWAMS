package components

import "github.com/komiga092-glitch/pwams/internal/i18n"

templ LoginPage(errorMsg string, lang string) {
	<!DOCTYPE html>
	<html lang={ lang }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ i18n.T(lang, "login.title") }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/vendor/htmx.min.js"></script>
		</head>
		<body>
			<div class="login-page">
				<section class="login-card">
					<header class="login-header">
						<img src="/static/images/org-logo.png" alt="PWA logo" width="64" height="64"/>
						<div class="login-org-names">
							<div style="font-size:20px;font-weight:700;color:#29377f;">
								{ i18n.T(lang, "login.org_name_ta") }
							</div>
							<div style="font-size:14px;font-weight:600;color:#29377f;">
								{ i18n.T(lang, "login.org_name_en") }
							</div>
						</div>
						<img src="/static/images/vendor-logo.png" alt="Arputham Software Solutions" height="40"/>
					</header>
					<h2 style="text-align:center;color:#29377f;font-weight:700;margin:20px 0 24px;">
						{ i18n.T(lang, "login.title") }
					</h2>
					if errorMsg != "" {
						<div class="alert alert-danger" data-auto-dismiss>{ errorMsg }</div>
					}
					<form
						method="POST"
						action="/login"
						hx-post="/login"
						hx-target="body"
						hx-swap="outerHTML"
						hx-indicator="#login-spinner"
					>
						<div class="form-group" style="margin-bottom:16px;">
							<label class="form-label" for="login">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:6px;" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="2"></circle><path d="M5.5 19a4.5 4.5 0 0 1 7 0"></path><path d="M15 9h4"></path><path d="M15 13h4"></path></svg>
								{ i18n.T(lang, "login.user_id") }
							</label>
							<input
								class="form-control"
								id="login"
								name="login"
								type="text"
								autocomplete="username"
								placeholder={ i18n.T(lang, "login.user_id") }
								required
							/>
						</div>
						<div class="form-group" style="margin-bottom:14px;">
							<label class="form-label" for="password">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:6px;" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
								{ i18n.T(lang, "login.password") }
							</label>
							<input
								class="form-control"
								id="password"
								name="password"
								type="password"
								autocomplete="current-password"
								placeholder={ i18n.T(lang, "login.password") }
								required
							/>
						</div>
						<div style="text-align:right;font-size:13px;margin-bottom:20px;">
							<a href="/forgot-password" style="color:#29377f;font-weight:600;">{ i18n.T(lang, "login.forgot_password") }</a>
						</div>
						<div style="text-align:center;">
							<button
								type="submit"
								style="background:#29377f;color:#fff;font-weight:700;padding:12px 48px;border-radius:8px;border:none;cursor:pointer;"
							>
								<span id="login-spinner" class="htmx-indicator" style="margin-right:8px;">⏳</span>
								{ i18n.T(lang, "login.sign_in") }
							</button>
						</div>
					</form>
					<div style="text-align:center;margin-top:16px;font-size:12px;">
						<a href="/login?lang=en">English</a> ·
						<a href="/login?lang=ta">தமிழ்</a> ·
						<a href="/login?lang=si">සිංහල</a>
					</div>
				</section>
			</div>
			<script src="/static/js/app.js"></script>
		</body>
	</html>
}

