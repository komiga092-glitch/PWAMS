package components

templ VerifyResetOTPPage(errorMsg string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>PWAMS - Verify Reset Code</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/vendor/htmx.min.js"></script>
		</head>
		<body>
			<div class="login-page">
				<section class="login-form-side" style="width:100%;max-width:480px;">
					<div class="login-card">
						<h2>Verify Reset Code</h2>
						<p class="subtitle">Enter the code sent to your email.</p>
						if errorMsg != "" {
							<div class="alert alert-danger">{ errorMsg }</div>
						}
						<form
							hx-post="/verify-reset-otp"
							hx-target="body"
							hx-swap="outerHTML"
						>
							<div class="form-group" style="margin-bottom:16px;">
								<label class="form-label" for="otp">Reset Code</label>
								<input class="form-control" id="otp" name="otp" type="text" maxlength="6" required/>
							</div>
							<button class="btn btn-primary" style="width:100%;" type="submit">Verify Code</button>
						</form>
						<div style="text-align:center;margin-top:18px;">
							<a href="/forgot-password" style="color:var(--primary);font-size:13px;font-weight:700;">Resend Code</a>
						</div>
					</div>
				</section>
			</div>
		</body>
	</html>
}
