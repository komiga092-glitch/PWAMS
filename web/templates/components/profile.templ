package components

type ProfileData struct {
	Username string
	Email    string
	Role     string
	Name     string
}

templ ProfilePage(profile ProfileData, passwordUpdated bool, passwordError string, errorMsg string) {
	@Base("PWAMS - Profile") {
		<section class="page">
			<div class="page-heading">
				<div>
					<h1>My Profile</h1>
					<p>View and manage your account.</p>
				</div>
			</div>
			if errorMsg != "" {
				<div class="alert alert-danger">{ errorMsg }</div>
			}
			<div class="dashboard-grid">
				<div class="panel">
					<div class="panel-header"><h2>Profile Information</h2></div>
					<div class="panel-body">
						<div class="form-section">
							<div class="form-row">
								<div class="form-field"><label>Username</label><div>{ profile.Username }</div></div>
								<div class="form-field"><label>Email</label><div>{ profile.Email }</div></div>
							</div>
							<div class="form-row">
								<div class="form-field"><label>Role</label><div>{ profile.Role }</div></div>
								<div class="form-field"><label>Name</label><div>{ profile.Name }</div></div>
							</div>
						</div>
					</div>
				</div>
				<div class="panel" id="change-password">
					<div class="panel-header"><h2>Change Password</h2></div>
					<div class="panel-body">
						if passwordUpdated {
							<div class="alert alert-success">Password updated successfully.</div>
						}
						if passwordError != "" {
							<div class="alert alert-danger">{ passwordError }</div>
						}
						<form
							hx-post="/profile/password"
							hx-target="#change-password"
							hx-swap="innerHTML"
						>
							<div class="form-section">
								<div class="form-field">
									<label for="current_password">Current Password</label>
									<input id="current_password" name="current_password" type="password" class="input" required/>
								</div>
								<div class="form-field">
									<label for="new_password">New Password</label>
									<input id="new_password" name="new_password" type="password" class="input" minlength="8" required/>
								</div>
								<div class="form-field">
									<label for="confirm_password">Confirm Password</label>
									<input id="confirm_password" name="confirm_password" type="password" class="input" minlength="8" required/>
								</div>
							</div>
							<div class="form-actions">
								<button type="submit" class="btn btn-primary">Update Password</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</section>
	}
}
