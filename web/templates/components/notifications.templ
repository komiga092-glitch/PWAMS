package components

type Notification struct {
	ID      uint
	Title   string
	Message string
	Read    bool
	Date    string
}

templ NotificationsPage(notifications []Notification, errorMsg string) {
	@Base("PWAMS - Notifications") {
		<section class="page">
			<div class="page-heading">
				<div>
					<h1>Notifications</h1>
					<p>View your notifications and alerts.</p>
				</div>
			</div>
			if errorMsg != "" {
				<div class="alert alert-danger">{ errorMsg }</div>
			}
			<div class="panel">
				<div class="panel-header">
					<h2>Notifications</h2>
					<span class="badge">{ itoa(len(notifications)) } Items</span>
				</div>
				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr><th>Title</th><th>Message</th><th>Date</th><th>Status</th></tr>
						</thead>
						<tbody>
							for _, n := range notifications {
								<tr>
									<td>{ n.Title }</td>
									<td>{ n.Message }</td>
									<td>{ n.Date }</td>
									<td>
										if n.Read {
											<span class="badge badge-muted">Read</span>
										} else {
											<span class="badge badge-success">New</span>
										}
									</td>
								</tr>
							}
							if len(notifications) == 0 {
								<tr><td colspan="4" class="empty">No notifications.</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</section>
	}
}
