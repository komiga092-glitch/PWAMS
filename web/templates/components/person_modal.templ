package components

templ PersonModalForm(data PersonFormData) {
	<div class="modal-content">
		<div class="modal-header">
			<div>
				<h2>Add Care Seeker</h2>
				<p>Enter the person's basic information.</p>
			</div>
			<button type="button" class="modal-close" onclick="this.closest('.modal').classList.add('hidden')">&times;</button>
		</div>
		<div class="modal-body">
			<form
				id="person-create-form"
				hx-post="/persons"
				hx-target="#persons-list"
				hx-swap="innerHTML"
				hx-on::after-request="this.closest('.modal').classList.add('hidden')"
			>
				<div class="form-grid">
					<div class="form-group">
						<label class="form-label" for="person_full_name">Full Name *</label>
						<input id="person_full_name" name="full_name" type="text" class="form-control" minlength="3" maxlength="150" required/>
					</div>
					<div class="form-group">
						<label class="form-label" for="person_nic">NIC / Passport</label>
						<input id="person_nic" name="nic_passport" type="text" class="form-control" maxlength="50" required/>
					</div>
					<div class="form-group">
						<label class="form-label" for="person_phone">Phone</label>
						<input id="person_phone" name="phone" type="text" class="form-control" maxlength="20"/>
					</div>
					<div class="form-group">
						<label class="form-label" for="person_gender">Gender</label>
						<select id="person_gender" name="gender" class="form-control">
							<option value="">Select Gender</option>
							<option value="Male">Male</option>
							<option value="Female">Female</option>
							<option value="Other">Other</option>
						</select>
					</div>
					<div class="form-group">
						<label class="form-label" for="person_date_of_birth">Date of Birth</label>
						<input id="person_date_of_birth" name="date_of_birth" type="date" class="form-control"/>
					</div>
					<div class="form-group">
						<label class="form-label" for="person_address">Address</label>
						<input id="person_address" name="address" type="text" class="form-control" maxlength="255"/>
					</div>
					<div class="form-group full">
						<label class="form-label" for="person_remarks">Remarks</label>
						<textarea id="person_remarks" name="remarks" class="form-control" rows="3"></textarea>
					</div>
				</div>
				<div class="form-actions">
					<button type="button" class="btn btn-secondary" onclick="this.closest('.modal').classList.add('hidden')">Cancel</button>
					<button type="submit" class="btn btn-primary">Save Care Seeker</button>
				</div>
			</form>
		</div>
	</div>
}
