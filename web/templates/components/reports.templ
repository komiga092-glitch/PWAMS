package components

templ ReportsPage(errorMsg string) {
	@Base("PWAMS - Reports") {
		<section class="page">
			<div class="page-heading">
				<div>
					<h1>Reports</h1>
					<p>Generate and view system reports.</p>
				</div>
			</div>
			if errorMsg != "" {
				<div class="alert alert-danger">{ errorMsg }</div>
			}
			<div class="dashboard-grid">
				<div class="panel">
					<div class="panel-header"><h2>Available Reports</h2></div>
					<div class="panel-body">
						<div class="quick-grid">
							<a class="quick-card" href="/reports/dashboard">
								<div class="quick-icon">📊</div>
								<div class="quick-title">Dashboard Summary</div>
								<div class="quick-text">Overview of key metrics</div>
							</a>
							<a class="quick-card" href="/reports/persons">
								<div class="quick-icon">♟</div>
								<div class="quick-title">Beneficiary Report</div>
								<div class="quick-text">Person statistics</div>
							</a>
							<a class="quick-card" href="/reports/donations">
								<div class="quick-icon">◈</div>
								<div class="quick-title">Donation Report</div>
								<div class="quick-text">Donation summaries</div>
							</a>
							<a class="quick-card" href="/reports/loans">
								<div class="quick-icon">₹</div>
								<div class="quick-title">Loan Report</div>
								<div class="quick-text">Loan performance</div>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	}
}
