package components

type Donor struct {
	ID       uint
	Name     string
	Email    string
	Phone    string
	Type     string
	Status   string
}

templ DonorsPage(donors []Donor, search string, errorMsg string) {
	@Base("PWAMS - Donors") {
		<section class="page">
			<div class="page-heading">
				<div>
					<h1>Donors</h1>
					<p>Manage donor records and contributions.</p>
				</div>
				<button
					type="button"
					class="btn btn-primary"
					data-roles="Super Admin,Admin,Staff"
					hx-get="/donors/new"
					hx-target="body"
					hx-swap="innerHTML"
				>+ Add Donor</button>
			</div>
			<div class="panel students-filter-panel">
				<div class="panel-body">
					<form class="students-filter" hx-get="/donors/page" hx-target="#donors-list" hx-swap="innerHTML" hx-trigger="submit, change from:select[name=status]">
						<div>
							<label for="donor-search">Search</label>
							<input id="donor-search" type="text" name="search" placeholder="Search name or email..." value={ search } hx-trigger="keyup changed delay:300ms" hx-get="/donors/page" hx-target="#donors-list"/>
						</div>
						<div class="students-filter-action">
							<button type="submit" class="btn btn-secondary">Search</button>
						</div>
					</form>
				</div>
			</div>
			if errorMsg != "" {
				<div class="alert alert-danger">{ errorMsg }</div>
			}
			<div id="donors-list">
				<div class="panel">
					<div class="panel-header">
						<h2>Donor List</h2>
						<span class="badge">{ itoa(len(donors)) } Records</span>
					</div>
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th>Status</th><th>Actions</th></tr>
							</thead>
							<tbody>
								for _, d := range donors {
									<tr>
										<td>{ d.Name }</td>
										<td>{ d.Email }</td>
										<td>{ d.Phone }</td>
										<td>{ d.Type }</td>
										<td>
											if d.Status == "Active" {
												<span class="badge badge-success">Active</span>
											} else {
												<span class="badge badge-muted">{ d.Status }</span>
											}
										</td>
										<td>
											<div class="table-actions">
												<a href={ "/donors/" + itoa(int(d.ID)) + "/view" } class="btn btn-secondary">View</a>
												<a href={ "/donors/" + itoa(int(d.ID)) + "/edit" } class="btn btn-primary">Edit</a>
											</div>
										</td>
									</tr>
								}
								if len(donors) == 0 {
									<tr><td colspan="6" class="empty">No donors found.</td></tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</section>
	}
}
