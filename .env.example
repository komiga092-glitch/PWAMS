APP_NAME=PWAMS
APP_ENV=production
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=pwams
DB_PASSWORD=change-me-db-password
DB_NAME=pwams
DB_SSLMODE=require

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Comma separated list of reverse proxy IPs/CIDRs whose X-Forwarded-For and
# X-Real-IP headers may be trusted. Leave empty when PWAMS is exposed
# directly: the client IP is then always taken from the TCP connection and
# the login/OTP/password-reset rate limits cannot be spoofed.
TRUSTED_PROXIES=
