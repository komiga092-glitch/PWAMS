{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "rootDir": "./web/static/ts",
    "outDir": "./web/static/js",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["web/static/ts/**/*.ts"],
  "exclude": ["node_modules"]
}
